; Compact patch and note commands use the same output frontier as PCM.
patch_commit:
        BIT 6,B
        JR Z,patch_commit_normal
        LD A,C
        OR $30
        LD L,A
        LD H,$1F
        LD A,(HL)
        OR A
        JP NZ,music_sync_written
        LD A,1
        LD (PREMODE),A
        JR patch_commit_transfer
patch_commit_normal:
        BIT 5,B
        JR Z,patch_commit_transfer
        LD A,3
        LD (PREMODE),A
patch_commit_transfer:
        CALL patch_transfer
        JP music_sync_written
