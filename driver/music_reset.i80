music_sync_reset:
        PUSH AF
        DI
        XOR A
        LD HL,$1A00
        LD (SYNCQHEAD),HL
        LD (SYNCQTAIL),HL
        LD (SYNCQCOUNT),A
        LD (SYNCCAPTURE),A
        LD (PATCHBUSY),A
        LD IYL,A
        EX AF,AF'
        CALL music_sync_restore
        EI
        POP AF
        RET

