; Patch bytes must reach the operator scan before another address (including
; a DAC poll) replaces the latch. Busy counts internal YM clocks, not input
; clocks. Poll between bounded pairs; keep each write/settle span atomic.
patch_quad:
        PUSH BC
        LD B,4
patch_quad_operator:
        BIT 0,B
        JR NZ,patch_quad_ready
        RST $08
patch_quad_ready:
        LD A,(DE)
        INC DE
        CALL patch_write
        LD A,C
        ADD A,4
        LD C,A
        DJNZ patch_quad_operator
        POP AF ; recover the outer group count; C already holds the next register
        LD B,A
        RET
patch_write:
        DI
        LD (HL),C
        INC L
        LD (HL),A
        DEC L
patch_wait:
        LD A,($4000)
        AND $80
        JR NZ,patch_wait
        EI
        RET
