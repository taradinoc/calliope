; Resident pure-Z80 sequencer, accepting BGM1 revisions 12 and 13.
; Clock, queue flags and overlays: docs/z80-scheduling.md.
SHARED  EQU $1D00
READY   EQU SHARED
CMDW    EQU SHARED+1
CMDR    EQU SHARED+2
EVTW    EQU SHARED+3
EVTR    EQU SHARED+4
FAULT   EQU SHARED+5
PROTECT EQU SHARED+6
REGION  EQU SHARED+7
GEN     EQU SHARED+8
TICK    EQU SHARED+10
PLAYING EQU SHARED+14
BASE    EQU SHARED+16
DONEGEN EQU SHARED+20
DONE    EQU SHARED+22
PENDING EQU $1E80
WAIT    EQU $1E81
SEQ     EQU $1E82
BANK    EQU $1E85
ORDERS  EQU $1E86
COUNT   EQU $1E89
LOOPORD EQU $1E8A
ORDER   EQU $1E8B
RPTR    EQU $1E90
PATCHES EQU $1E93
PALACC  EQU $1E97 ; Timer-B fractional-period accumulator (also in PAL)
PAUSED  EQU $1E9D
TEMP    EQU $1EE0
PATCH   EQU $1700
CONTEXT EQU $1F75
MUSICMASK EQU $1F76
CURSFX  EQU $1EDB
NOTETEMP EQU $1F60 ; current FM f-number/block, little endian
OWNERS  EQU $1F20
MUSPATCH EQU $1F05
FMKEYS  EQU $1F0A ; five physical key-on masks, in YM operator order
DIRTY   EQU $1F30
        ORG 0
        DI
        JP init
        BLOCK $08-$
        INCLUDE "dac.i80"
        BLOCK $38-$
vint:
        PUSH AF
        CALL dac_irq
        PUSH BC
        LD B,16
vint_hold:
        DJNZ vint_hold
        POP BC
        POP AF
        EI
        RETI
main:
        CALL pcm_service
        LD A,(PROTECT)
        OR A
        JR NZ,main
        LD A,(PENDING)
        CP 2
        CALL C,commands ; preserve audio progress under control-ring backpressure
        RST $08
        LD A,(PENDING)
        OR A
        JR Z,main
        DI
        LD A,(PENDING)
        DEC A
        LD (PENDING),A
        CALL frame_deadline
        CALL tick
        RST $08
        JR main
; YM write: D = address, E = value, C = physical channel.
; DAC service may change the address latch; the final address/data pair is atomic.
ym:
        JP ym_direct
ym_direct:
        PUSH AF
ym_busy:
        RST $08
        LD A,($4000)
        AND $80
        JR NZ,ym_busy
        DI
        LD A,C
        CP 3
        JR NC,ym_port1
        LD A,D
        LD ($4000),A
        LD A,E
        LD ($4001),A
        EI
        POP AF
        RET
ym_port1:
        LD A,D
        LD ($4002),A
        LD A,E
        LD ($4003),A
        EI
        POP AF
        RET
keyoff:
        LD A,C
        CP 5
        JP NC,pair_keyoff
        CP 3
        JR C,key_number
        INC A
key_number:
        LD E,A
        LD D,$28
        PUSH BC
        LD C,0
        CALL ym
        POP BC
        RET
silence:
        RST $08
        LD A,(PROTECT)
        OR A
        JR NZ,silence
        LD C,0
silence_loop:
        CALL music_blocked
        CALL Z,silence_channel
        INC C
        LD A,C
        CP 9
        JR NZ,silence_loop
        RET
; Set RPTR from a bank-relative 24-bit pointer in HL.
relative:
        LD A,(BASE)
        ADD A,(HL)
        LD (RPTR),A
        INC HL
        LD A,(BASE+1)
        ADC A,(HL)
        LD (RPTR+1),A
        INC HL
        LD A,(BASE+2)
        ADC A,(HL)
        LD (RPTR+2),A
        RET
; Read one byte, preserving all registers except AF. Increment 24-bit RPTR.
read:
        CALL pcm_rom_guard
        PUSH HL
        PUSH BC
        PUSH DE
        LD A,(RPTR+1)
        RLCA
        LD A,(RPTR+2)
        RLA
        LD B,A
        LD A,(BANK)
        CP B
        JR Z,read_mapped
        LD A,B
        LD (BANK),A
        LD HL,$6000
        LD E,A
        LD B,4
bank_bits:
        LD A,E
        LD (HL),A
        RRCA
        LD (HL),A
        RRCA
        LD E,A
        ; Nine latch writes are one transaction. RST $08 may commit a queued
        ; patch, recursively read ROM and restore the bank mid-transaction.
        ; IRQ DAC service does not touch the latch; this span is <200 clocks.
        DJNZ bank_bits
        XOR A
        LD (HL),A
read_mapped:
        LD A,(PROTECT)
        OR A
        JP NZ,read_retry
        LD HL,(RPTR)
        SET 7,H
        LD E,(HL)
        LD HL,RPTR
        INC (HL)
        JR NZ,read_done
        INC HL
        INC (HL)
        JR NZ,read_done
        INC HL
        INC (HL)
read_done:
        RST $08
        LD A,E
        POP DE
        POP BC
        POP HL
        RET
; Music and SFX refill twelve bytes from the current cursor.
; Patterns stay inside one ROM bank; bytes beyond their terminator are unused.
; The former cache tail holds the channel schedule and sixteen cursors.
SEQCACHE EQU $1900
SEQVALID EQU $1F4D
fetch:
        RST $08
        LD A,(SEQVALID)
        OR A
        JR Z,fetch_miss
fetch_cached:
        LD A,12
        LD HL,SEQVALID
        SUB (HL)
        DEC (HL)
        LD L,A
        LD H,$19
        LD A,(HL)
        LD HL,SEQ
        INC (HL)
        RET NZ
        INC HL
        INC (HL)
        RET NZ
        INC HL
        INC (HL)
        RET
fetch_miss:
        PUSH BC
        PUSH DE
        ; PCM refill uses IX for its source; keep the active SFX/voice cursor.
        PUSH IX
        CALL music_sync_audio
        POP IX
fetch_refill:
        LD HL,(SEQ)
        LD DE,SEQCACHE
        LD BC,12
fetch_map:
        LD (RPTR),HL
        LD A,(SEQ+2)
        LD (RPTR+2),A
        CALL read
        LD HL,(RPTR)
        DEC HL
        SET 7,H
; read polls the DAC immediately before this bounded twelve-byte copy.
; Keep DMA checks between four-byte groups; the copy fits one sample period.
fetch_copy:
        RST $08
        LD A,(PROTECT)
        OR A
        JR NZ,fetch_protected
        LDI
        LDI
        LDI
        LDI
        LD A,C
        OR A
        JR NZ,fetch_copy
        LD A,12
        LD (SEQVALID),A
        POP DE
        POP BC
        JR fetch_cached
fetch_protected:
        CALL music_yield
        ; Resident mixing may bank another source: restart and remap the fill.
        JR fetch_refill
commands:
        LD A,(CMDR)
        LD B,A
        LD A,(CMDW)
        CP B
        RET Z
        LD A,B
        AND 15
        ADD A,A
        ADD A,A
        ADD A,A
        LD L,A
        LD H,0
        LD DE,$1D40
        ADD HL,DE
        LD DE,TEMP
        LD BC,8
        LDIR
        LD A,(CMDR)
        INC A
        LD (CMDR),A
        LD A,(TEMP)
        CP 1
        JP Z,start
        CALL command_generation
        RET NZ
        LD A,(TEMP)
        CP 2
        JR Z,stop
        CP 3
        JR Z,stop_all
        CP 4
        JP Z,pcm_sfx
        CP 5
        JP Z,pcm_music
        CP 6
        JP Z,stop_token
        CP 7
        JR Z,pause_music
        CP 8
        JR Z,resume_music
        CP 9
        JP Z,fm_sfx_start
        CP 10
        JP Z,mute_music
        CP 11
        JP Z,parts_request
        CP 12
        JP Z,music_volume
        CP 13
        JP Z,tempo_request
        LD A,2
        LD (FAULT),A
        RET
; Start and SFX tokens are not song generations. Reject stale music controls.
command_generation:
        CP 2
        JR Z,command_check_generation
        CP 7
        JR C,command_any_generation
        CP 9
        JR Z,command_any_generation
command_check_generation:
        LD HL,(TEMP+2)
        LD DE,(GEN)
        OR A
        SBC HL,DE
        RET
command_any_generation:
        XOR A
        RET
stop_all:
        CALL fm_sfx_stop_all
        CALL pcm_stop
stop:
        CALL pcm_cancel_music
        XOR A
        LD (PLAYING),A
        LD (TEMPOREQ),A
        CALL music_sync_reset
        JP silence
pause_music:
        CALL music_sync_reset
        LD HL,DIRTY
        LD B,9
pause_wait_note:
        LD (HL),1
        INC HL
        DJNZ pause_wait_note
        LD A,1
        LD (PAUSED),A
        CALL pcm_cancel_music
        JP silence
resume_music:
        XOR A
        LD (PAUSED),A
        RET
start:
        CALL pcm_cancel_music
        CALL silence
        XOR A
        LD (DONE),A
        CALL music_sync_reset
        LD (MUSICNOISE),A
        LD (PAUSED),A
        LD (WAIT),A
        LD (ORDER),A
        LD HL,SHARED+33
        INC (HL) ; odd: elapsed publication in progress
        LD (TICK),A
        LD (TICK+1),A
        LD (TICK+2),A
        LD (TICK+3),A
        LD HL,(TEMP+2)
        LD (GEN),HL
        LD HL,SHARED+33
        INC (HL) ; even: tick reset and generation published
        LD HL,TEMP+4
        CALL relative
        CALL read
        CALL read
        CALL read
        LD (COUNT),A
        CALL read
        LD (LOOPORD),A
        LD HL,ORDERS
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        CALL read
        LD (MUSICMASK),A
        CALL parts_load
        CALL cache_patches
        ; Prepare leading FM patches while every new-song channel is silent.
        ; The audible clock starts only after cold ROM/setup work completes.
        LD A,2
        LD (PLAYING),A
        CALL order_load
        CALL channels_tick
        LD HL,PLAYING
        DEC (HL)
        XOR A
        LD (PENDING),A
        LD (PALACC),A
        RET
order_load:
        XOR A
        LD (SEQVALID),A
        LD HL,ORDERS
        CALL relative
        LD A,(ORDER)
        LD E,A
        LD D,0
        LD HL,(RPTR)
        ADD HL,DE
        ADD HL,DE
        ADD HL,DE
        LD (RPTR),HL
        LD A,(RPTR+2)
        ADC A,0
        LD (RPTR+2),A
        LD HL,TEMP+4
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        LD HL,TEMP+4
        CALL relative
        JP channels_load
music_tick:
        RST $08
        LD A,(PAUSED)
        OR A
        RET NZ
        LD A,(PLAYING)
        OR A
        RET Z
        LD HL,SHARED+33
        INC (HL)
        LD HL,TICK
        INC (HL)
        JR NZ,music_channels
        INC HL
        INC (HL)
        JR NZ,music_channels
        INC HL
        INC (HL)
        JR NZ,music_channels
        INC HL
        INC (HL)
music_channels:
        LD HL,SHARED+33
        INC (HL)
        XOR A
        CALL channels_sync
        CALL tick_wait
        LD A,(PLAYING)
        OR A
        RET Z
        JP channels_tick
tick_wait:
        LD HL,WAIT
        LD A,(HL)
        OR A
        JR Z,decode
        DEC (HL)
        RET NZ
decode:
        CALL fetch
        CP $80
        JR C,decode_patch
        CP $FD
        JR NC,decode_normal
        SUB $7F
        LD (WAIT),A
        RET
decode_patch:
        CP $40
        JR C,decode_normal
        CP $50
        JR C,decode_bound_patch
        AND 3
        JP level_single
decode_bound_patch:
        SUB $40
        CALL part_bind
        XOR A
        LD (SHORTREQ),A
        JP patch_bound
decode_normal:
        OR A
        JP Z,wait_op
        CP $10
        JP Z,patch_op
        CP $11
        JP Z,note_op
        CP $13
        JP Z,off_op
        CP $15
        JP Z,part_boundary
        CP $16
        JP Z,pan_op
        CP $20
        JP Z,event_op
        RST $30
        CP $30
        JP Z,psg_op
        CP $31
        JP Z,pcm_op
        CP $32
        JP Z,pcm_off_op
        CP $33
        JP Z,noise_note
        CP $35
        JP Z,psg_update_op
        CP $37
        JP Z,level_op
        CP $36
        JP Z,pitch_op
        CP $34
        JP Z,clock_change
        CP $39
        JP Z,lfo_op
        CP $3A
        JP Z,prefetch_queue_op
        CP $3B
        JP Z,patch_short_op
        CP $FD
        JR Z,next_order
        CP $FF
        JR Z,end_song
        LD A,3
        LD (FAULT),A
        JP stop
next_order:
        LD A,(ORDER)
        LD B,A
        LD A,(COUNT)
        CP B
        JR Z,loop_or_end
        LD A,B
        INC A
        LD (ORDER),A
        CALL order_load
        JR decode_patch_exit
loop_or_end:
        LD A,(LOOPORD)
        CP 255
        JR Z,end_song
        LD (ORDER),A
        CALL order_load
        JR decode_patch_exit
end_song:
        LD A,(CONTEXT)
        OR A
        JP NZ,fm_sfx_end
        CALL music_sync_flush
        LD HL,(GEN)
        LD (DONEGEN),HL
        LD A,1
        LD (DONE),A
        JP stop
off_op:
        CALL fetch_slot
        XOR A
        CALL part_note
        RST $08
        CALL voice_blocked
        RST $30
        CALL Z,keyoff
        JR decode_patch_exit
patch_short_op:
        LD A,$20
        JR patch_request
patch_op:
        XOR A
patch_request:
        LD (SHORTREQ),A
        CALL fetch_slot
patch_bound:
        CALL fetch
        LD B,A
        LD A,(CONTEXT)
        OR A
        JR NZ,patch_install
        CALL part_patch
        RST $08
        CALL part_blocked
        RST $30
        JR NZ,patch_continue
        LD HL,MUSPATCH
        LD E,C
        LD D,0
        ADD HL,DE
        LD (HL),B
        CALL music_blocked
        JR NZ,patch_continue
        LD HL,DIRTY
        ADD HL,DE
        LD (HL),0
patch_install:
        LD A,B
        CALL install_patch
patch_continue:
        LD A,(PLAYING)
        CP 2
        RET Z ; priming consumes exactly one leading patch, never a note
decode_patch_exit:
        JP decode
install_patch:
        LD E,A
        LD A,(SYNCCAPTURE)
        OR A
        LD A,E
        JR Z,install_patch_direct
patch_enqueue:
        LD D,255
        LD A,(SHORTREQ)
        OR C
        JP music_sync_enqueue
install_patch_direct:
        LD B,A
        LD HL,PATCHBUSY
        INC (HL)
        CALL level_address
        OR 4
        LD L,A
        LD A,(PREMODE)
        DEC A
        JR Z,patch_shadow_mode
        CP 2
        JR NZ,patch_shadow_mode
        BIT 5,(HL)
        JR Z,patch_not_prepared
        INC HL
        INC HL
        LD A,(HL)
        DEC HL
        DEC HL
        CP B
        JR Z,patch_shadow_mode
patch_not_prepared:
        XOR A
        LD (PREMODE),A
patch_shadow_mode:
        LD A,(PREMODE)
        DEC A
        LD A,$20 ; physical ID valid; +6 holds the installed ID
        JR NZ,patch_flags_ready
        LD A,$A0 ; prepared and physically muted until the short commit
patch_flags_ready:
        LD (HL),A
        INC HL
        INC HL
        LD (HL),B
        LD A,(PREMODE)
        CP 3
        JP Z,patch_short_ready
        LD A,B
        CALL cache_one_patch
        LD HL,FMKEYS
        LD E,C
        LD D,0
        ADD HL,DE
        LD A,(PATCH+30)
        RLCA
        RLCA
        RLCA
        RLCA
        LD (HL),A
patch_immediate:
        CALL keyoff
patch_full:
        PUSH BC
        LD HL,$4000
        LD DE,PATCH
        LD A,C
        CP 3
        JR C,patch_channel
        LD L,2
        SUB 3
patch_channel:
        ADD A,$30
        LD C,A
        LD B,7
patch_operator:
        CALL music_yield
        LD A,C
        AND $F0
        CP $40
        JR Z,patch_tl_group
        CALL patch_quad
        JR patch_group_done
patch_tl_group:
        PUSH BC
        LD B,4
patch_tl_operator:
        RST $08
        LD A,(PREMODE)
        DEC A
        JR Z,patch_mute_operator
        LD A,(DE)
        INC DE
        CALL patch_adjust
        JR patch_tl_write
; Preload only in a proven maximum-TL gap. Mute all operators before B0
; changes: a new algorithm can expose a previously non-carrier operator.
patch_mute_operator:
        INC DE
        LD A,127
patch_tl_write:
        CALL patch_write
        LD A,C
        ADD A,4
        LD C,A
        DJNZ patch_tl_operator
        LD A,C
        POP BC
        LD C,A
patch_group_done:
        DJNZ patch_operator
        SET 4,C
        LD B,2
patch_control:
        RST $08
        LD A,(DE)
        INC DE
        CALL patch_write
        SET 2,C
        DJNZ patch_control
patch_controls_done:
        POP BC
        JR patch_shadow_done
patch_short_ready:
        CALL keyoff
patch_shadow_done:
        XOR A
        LD (PREMODE),A
        LD (PATCHBUSY),A
        RET
note_op:
        CALL fetch_slot
        CALL fetch_frequency
        LD A,1
        CALL part_note
        RST $08
        CALL voice_blocked
        RST $30
        JR NZ,decode_note_exit
        LD A,(CONTEXT)
        OR A
        JR NZ,note_ready
        LD HL,DIRTY
        LD E,C
        LD D,0
        ADD HL,DE
        LD A,(HL)
        OR A
        JR Z,note_ready
        LD (HL),0
        LD HL,MUSPATCH
        ADD HL,DE
        XOR A
        LD (SHORTREQ),A
        LD A,(HL)
        CALL install_patch
        CALL level_from_part
        CALL level_current
        CALL pan_from_part
note_ready:
        CALL note_dispatch
        JR decode_note_exit
; Frequencies are compiled offline; continuous writes never restart envelopes.
pitch_op:
        CALL fetch_slot
        CALL fetch_frequency
        LD A,2
        CALL part_note
        RST $08
        CALL voice_blocked
        RST $30
        JR NZ,decode_note_exit
        LD A,(CONTEXT)
        OR A
        JR NZ,pitch_write
        LD HL,DIRTY
        LD E,C
        LD D,0
        ADD HL,DE
        LD A,(HL)
        OR A
        JR NZ,decode_note_exit
pitch_write:
        CALL frequency_write
decode_note_exit:
        JP decode
frequency_write:
        LD A,(NOTETEMP)
        LD B,A
        LD A,(NOTETEMP+1)
        LD E,A
        RST $08
        LD A,C
        CP 3
        JR C,note_channel
        SUB 3
note_channel:
        ADD A,$A4
        LD D,A
        CALL ym
        LD A,D
        SUB 4
        LD D,A
        LD E,B
        JP ym
note_write:
        CALL keyoff
        CALL frequency_write
        LD HL,FMKEYS
        LD E,C
        LD D,0
        ADD HL,DE
        LD B,(HL)
        LD A,C
        CP 3
        JR C,note_key
        INC A
note_key:
        RST $30
        OR B
        LD E,A
        LD D,$28
        LD C,0
        JP ym
event_op:
        LD A,(EVTW)
        LD B,A
        LD A,(EVTR)
        LD C,A
        LD A,B
        SUB C
        CP 16
        JR NC,event_drop
        LD A,B
        AND 15
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        LD D,H
        LD E,L
        ADD HL,HL
        ADD HL,DE
        LD DE,$1DC0
        ADD HL,DE
        LD (HL),1
        INC HL
        LD (HL),0
        INC HL
        LD B,4
        CALL fetch_block
        ; Generation and logical tick are contiguous in the shared ABI.
        ; Copy six resident bytes as one block; vint only changes PENDING.
        LD DE,GEN
        EX DE,HL
        LD BC,6
        LDIR
        LD A,(EVTW)
        INC A
        LD (EVTW),A
        JR decode_note_exit
; B resident operands -> HL, preserving BC/DE and advancing HL and SEQ.
; Poll the DAC between two-byte groups. Window crossings use normal fetches.
fetch_block:
        PUSH BC
        PUSH DE
        RST $08
        LD A,(SEQVALID)
        CP B
        JR C,fetch_block_slow
        PUSH BC
        SUB B
        LD (SEQVALID),A
        ADD A,B
        NEG
        ADD A,12
        LD D,H
        LD E,L
        LD L,A
        LD H,$19
        LD C,B
        LD B,0
fetch_block_copy:
        LDI
        LD A,C
        OR A
        JR Z,fetch_block_advance
        LDI
        RST $08
        LD A,C
        OR A
        JR NZ,fetch_block_copy
fetch_block_advance:
        EX DE,HL
        POP BC
        PUSH HL
        LD HL,SEQ
        LD A,(HL)
        ADD A,B
        LD (HL),A
        JR NC,fetch_block_done
        INC HL
        INC (HL)
        JR NZ,fetch_block_done
        INC HL
        INC (HL)
fetch_block_done:
        POP HL
        JR fetch_block_return
fetch_block_slow:
        PUSH HL
        CALL fetch
        POP HL
        LD (HL),A
        INC HL
        DJNZ fetch_block_slow
fetch_block_return:
        RST $30
        POP DE
        POP BC
        RET
event_drop:
        LD HL,(SHARED+24)
        LD A,H
        AND L
        CP 255
        JR Z,event_lost_saturated
        INC HL
        LD (SHARED+24),HL
event_lost_saturated:
        ; Cue loss is nonfatal; the saturating loss counter remains observable.
        LD B,4
event_discard:
        CALL fetch
        DJNZ event_discard
        JR decode_psg_exit
PSGUPDATE EQU $1F57
psg_update_op:
        LD A,1
        JR psg_set_update
psg_op:
        XOR A
psg_set_update:
        LD (PSGUPDATE),A
        CALL fetch
        LD B,A
psg_bytes:
        CALL fetch
        CALL part_psg
        CALL psg_write
        DJNZ psg_bytes
decode_psg_exit:
        JP decode
pcm_op:
        LD B,3
        LD DE,TEMP+4
pcm_operand:
        CALL fetch
        LD (DE),A
        INC DE
        DJNZ pcm_operand
        CALL part_blocked
        JR NZ,decode_psg_exit
        LD A,(MUTEMASK+1)
        BIT 1,A
        JR NZ,decode_psg_exit
        XOR A
        LD (TEMP+7),A
        LD (TEMP+2),A
        LD (TEMP+3),A
        CALL pcm_music
        JP music_sync_begin
        INCLUDE "pcm.i80"
        INCLUDE "fm_sfx.i80"
        INCLUDE "parts.i80"
PATCHID EQU $1F5C
cache_one_patch:
        LD HL,PATCHID
        CP (HL)
        RET Z
        LD (HL),A
        PUSH BC
        PUSH DE
cache_patch_restart:
        RST $08
        LD HL,PATCHES
        CALL relative
        LD A,(PATCHID)
        LD L,A
        LD H,0
        RST $08
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,(RPTR)
        ADD HL,DE
        LD (RPTR),HL
        LD A,(RPTR+2)
        ADC A,0
        LD (RPTR+2),A
        RST $08
        CALL read
        LD HL,(RPTR)
        DEC HL
        SET 7,H
        LD DE,PATCH
        LD BC,32
cache_patch_group:
        RST $08
        LD A,(PROTECT)
        OR A
        JP NZ,cache_patch_protected
        LDI
        LDI
        LDI
        LDI
        LD A,C
        OR A
        JR NZ,cache_patch_group
        POP DE
        POP BC
        RET
music_yield:
        ; Only save the ROM reader and caller registers when a refill can
        ; actually do work. Otherwise this yield is just a DAC poll.
        RST $08
        ; A queued patch may poll here on the producer's own stack. It must
        ; not resume that same stack recursively. Main-side DMA waits can fill.
        LD A,(FILLRUN)
        OR A
        RET NZ
        DI
        EXX
        LD A,IYH
        SUB C
        EXX
        EI
        CP 64
        RET NC
music_yield_fill:
        PUSH BC
        PUSH DE
        PUSH HL
        PUSH IX
        LD HL,(RPTR)
        PUSH HL
        LD A,(RPTR+2)
        PUSH AF
        CALL pcm_service
        POP AF
        LD (RPTR+2),A
        POP HL
        LD (RPTR),HL
        POP IX
        POP HL
        POP DE
        POP BC
        RET
        INCLUDE "volume.i80"
        INCLUDE "fm_volume.i80"
        INCLUDE "sfx_loop.i80"
        INCLUDE "part_note.i80"
        INCLUDE "timing.i80"
        INCLUDE "tempo.i80"
        INCLUDE "noise.i80"
        INCLUDE "pair_keyoff.i80"
        INCLUDE "channels.i80"
        INCLUDE "music_sync.i80"
        INCLUDE "music_registers.i80"
        INCLUDE "music_audio.i80"
        INCLUDE "music_reset.i80"
; Note-off alone leaves an audible FM release tail after stop/pause/EOF.
; Keep the authored TL shadows so dirty voices can restore on resume.
music_sync_begin EQU decode
        INCLUDE "patch_queue.i80"
PREMODE EQU $1F68
SHORTREQ EQU $1F6A
pan_output:
        CALL pan_write
        JP decode
cache_patch_protected:
        CALL music_yield
        JP cache_patch_restart
; Timer-B captures a fixed sample deadline, independent of refill chunk ends.
; Retired coroutine cursor storage is free; live mute/PSG state starts at 1F16.
FRAMEFRONT EQU $1F14
FRAMETARGET EQU SYNCFRONT
; A = pending ticks after consuming this one. Backlogged ticks keep their
; earlier deadline; an expired countdown saturates instead of wrapping.
frame_deadline:
        LD B,A
        EXX
        LD A,C
        EXX
        LD C,A
        LD A,(FRAMEFRONT)
        SUB C
        LD L,A
        LD H,0
frame_tick_samples:
        LD DE,111
        INC B
        JR frame_test
frame_backlog:
        OR A
        SBC HL,DE
frame_test:
        DJNZ frame_backlog
        LD A,L
        ADD A,C
        LD (FRAMETARGET),A
        LD A,L
        BIT 7,H
        JR Z,frame_on_time
        XOR A
frame_on_time:
        EX AF,AF'
        EI
        RET
prefetch_queue_op:
        CALL fetch_slot
        CALL fetch
        LD E,A
        CALL part_blocked
        JP NZ,decode
        LD A,C
        OR $40
        LD D,255
        CALL music_sync_enqueue
        JP decode
level_single_output:
        CALL ym
        JP decode
timer_b_probe:
        RRA
        RET NC
; Timer B is the audio clock; VBlank only provides an urgent DAC poll.
; One B increment is 16128 master clocks. Fractional 55/56 (NTSC) or
; 54/55 (PAL) periods average 59.9981/59.9999 Hz without video catch-up bursts.
frame_signal:
        LD A,(PALACC)
frame_fraction_add:
        ADD A,125
        LD (PALACC),A
frame_fraction_base:
        LD A,201
        JR NC,frame_timer_period
        DEC A
frame_timer_period:
        LD (HL),$26
        LD (DE),A
frame_timer_wait:
        LD A,($4000)
        AND $80
        JR NZ,frame_timer_wait
        LD (HL),$27
        LD A,$3F
        LD (DE),A
        LD A,C
        ADD A,248
        LD (FRAMEFRONT),A
        PUSH HL
        LD HL,PENDING
        LD A,(HL)
        CP 32
        JR NC,frame_overflow
        INC (HL)
        JR frame_signal_done
frame_overflow:
        LD A,1
        LD (FAULT),A
frame_signal_done:
        POP HL
        RET
; Restore the serial latch directly. A dummy ROM read can wait through DMA
; protection after an already-loaded patch and stall unrelated ready notes.
restore_patch_bank:
        LD HL,BANK
        CP (HL)
        RET Z
        LD (HL),A
        LD HL,$6000
        LD B,8
patch_bank_loop:
        LD (HL),A
        RRCA
        DJNZ patch_bank_loop
        XOR A
        LD (HL),A
        RET
patch_transfer:
        LD HL,(ym+1)
        PUSH HL
        LD HL,ym_direct
        LD (ym+1),HL
        BIT 7,B
        JR NZ,note_commit
        LD HL,(RPTR)
        PUSH HL
        LD A,(RPTR+2)
        PUSH AF
        LD A,(BANK)
        PUSH AF
        LD A,E
        CALL install_patch_direct
        POP AF
        CALL restore_patch_bank
        POP AF
        POP HL
        LD (RPTR),HL
        LD (RPTR+2),A
        JR patch_commit_done
note_commit:
        LD HL,(NOTETEMP)
        PUSH HL
        LD (NOTETEMP),DE
        CALL note_write
        POP HL
        LD (NOTETEMP),HL
patch_commit_done:
        POP HL
        LD (ym+1),HL
        RET
code_end:
        IF $ > $1700
        ERROR "Code overlaps patch cache at 0x1700"
        ENDIF
        BLOCK $1730-$
read_extension_start:
read_retry:
        POP DE
        POP BC
        POP HL
        JP read
read_extension_end:
        IF $ > $1738
        ERROR "ROM retry helper overlaps refill stack guard"
        ENDIF
        BLOCK $1738-$
        DB $A5,$A5,$A5,$A5,$A5,$A5,$A5,$A5 ; refill stack guard
        BLOCK $1740-$
        INCLUDE "patch_output.i80"
note_dispatch:
        LD A,(SYNCCAPTURE)
        OR A
        JP Z,note_write
        LD DE,(NOTETEMP)
        LD A,C
        OR $80
        JP music_sync_enqueue

; Keep the bounded operand helper in unused code space, not voice state.
        IF $ > $1780
        ERROR "Output helpers exceed former refill stack"
        ENDIF
        BLOCK $1780-$
extension_start:
        INCLUDE "part_psg.i80"
        INCLUDE "pair_owner.i80"
        INCLUDE "steal_order.i80"
extension_end:
        IF $ > $1800
        ERROR "PSG helpers overlap SFX state"
        ENDIF
        BLOCK $1840-$
pan_extension_start:
        INCLUDE "panning.i80"
pan_extension_end:
        IF $ > $1860
        ERROR "Panning helper overlaps control helpers"
        ENDIF
        BLOCK $1860-$
control_extension_start:
        INCLUDE "clock_load.i80"
        INCLUDE "tempo_rate.i80"
; Apply music gain to a TL value while the bulk writer uses DE as its cursor.
patch_adjust:
        PUSH HL
        PUSH DE
        EX DE,HL
        LD E,A
        LD D,C
        CALL patch_volume
        LD A,E
        POP DE
        POP HL
        RET
fetch_frequency:
        LD HL,NOTETEMP
        LD B,2
        JP fetch_block
cache_patches:
        JP cache_patches_cold
control_extension_end:
        IF $ > $18D8
        ERROR "Control helpers overlap FM level state"
        ENDIF
        BLOCK $190C-$
pan_check_start:
pan_check:
        LD A,C
        OR $30
        LD L,A
        LD H,$1F
        LD A,(HL)
        OR A
        JP NZ,decode
        JP pan_output
pan_check_end:
        IF $ > $1920
        ERROR "Panning guard overlaps channel schedule"
        ENDIF
pcm_descriptor_protected:
        CALL music_yield
        JP pcm_descriptor_restart
        IF $ > $1920
        ERROR "Descriptor helper overlaps channel schedule"
        ENDIF
        BLOCK $1930-$
pan_write_start:
pan_write:
        LD A,C
        CP 3
        JR C,pan_port
        SUB 3
pan_port:
        ADD A,$B4
        LD D,A
        JP ym
pan_write_end:
        IF $ > $193E
        ERROR "Panning write overlaps synchronization flag"
        ENDIF
; Before channels_load initializes all sixteen cursors, use their page for
; the one-time patch-directory loader. The trampoline retires itself to RET.
        BLOCK $1940-$
cache_patches_cold:
        ; Header patch pointer at relative 16.
        LD HL,(BASE)
        LD DE,16
        ADD HL,DE
        LD (RPTR),HL
        LD A,(BASE+2)
        ADC A,0
        LD (RPTR+2),A
        LD HL,PATCHES
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        INC HL
        CALL read
        LD (HL),A
        LD A,255
        LD (PATCHID),A
        LD A,1
        LD ($1E9E),A
        LD A,$C9
        LD (cache_patches),A
        RET
        IF $ > $1980
        ERROR "Cold patch loader exceeds track overlay"
        ENDIF
        BLOCK $1980-$
tone_group_extension_start:
        INCLUDE "tone_group.i80"
tone_group_extension_end:
        IF $ > $1A00
        ERROR "Tone-group helpers overlap synchronized chip queue"
        ENDIF
        IF $ > $1B00
        ERROR "Patch output overlaps logical voices"
        ENDIF
        BLOCK $1AC0-$
level_single:
        LD B,A
        CALL fetch
        LD E,A
        LD HL,(CURPART)
        LD A,L
        ADD A,9
        ADD A,B
        LD L,A
        LD (HL),E
        CALL voice_blocked
        JR NZ,level_single_done
        LD A,C
        OR $30
        LD L,A
        LD H,$1F
        LD A,(HL)
        OR A
        JR NZ,level_single_done
        CALL level_address
        ADD A,B
        LD L,A
        LD (HL),E
        INC HL
        LD A,C
        CP 3
        JR C,level_single_port
        SUB 3
level_single_port:
        ADD A,$40
        LD D,A
        LD A,B
        ADD A,A
        ADD A,A
        ADD A,D
        LD D,A
        CALL patch_volume
        JP level_single_output
level_single_done:
        JP decode
        IF $ > $1B00
        ERROR "Transfer body exceeds queue tail"
        ENDIF
; Boot code is dead before parts_load initializes the logical state page.
; This retains all sixteen parts and the full 256-byte PCM FIFO.
        BLOCK $1B00-$
init:
        LD SP,$2000
        IM 1
        XOR A
        LD (PENDING),A
        LD (WAIT),A
        LD (PLAYING),A
        LD (TEMPOREQ),A
        CALL music_sync_reset
        LD (PALACC),A
        DEC A
        LD (BANK),A
        CALL silence
pcm_init:
        XOR A
        LD (DACON),A
        LD (PCMSFX),A
        LD (PCM0+12),A
        LD (FILLBUSY),A
        LD (FILLRUN),A
        EXX
        LD BC,$1C00
        LD DE,$4001
        LD HL,$4000
        EXX
        LD A,192
        LD (OUTW),A
        LD IY,$C000
        LD C,0
        LD D,$24
        LD E,PCM_TIMER_A/4
        CALL ym
        LD D,$25
        LD E,PCM_TIMER_A & 3
        CALL ym
        LD D,$26
        LD A,(REGION)
        OR A
        LD E,200
        JR Z,timer_region_ready
        LD E,201
        LD A,251
        LD (frame_fraction_add+1),A
        LD A,202
        LD (frame_fraction_base+1),A
        LD A,110
        LD (frame_tick_samples+1),A
timer_region_ready:
        CALL ym
        LD D,$27
        LD E,$3F
        CALL ym
        LD D,$2B
        LD E,$80
        CALL ym
        JP init_finish
init_finish:
        LD HL,$1C00
        LD DE,$1C01
        LD BC,255
        LD (HL),$80
        LDIR
        LD A,1
        LD (DACON),A
        LD A,$F3
        LD (dac_service),A
        LD A,$80
        LD (READY),A
        EI
        JP main
        IF $ > $1C00
        ERROR "Boot overlay exceeds idle FIFO"
        ENDIF
        BLOCK $1D2C-$
; Shared fields end at byte 43; commands begin at byte 64.
        INCLUDE "music_restore.i80"
music_sync_prepare_direct:
        JP pcm_service
        IF $ > $1D40
        ERROR "Cold audio helpers overlap the host command ring"
        ENDIF
        BLOCK $1EB0-$
silence_extension_start:
silence_channel:
        CALL keyoff
        LD A,C
        CP 5
        RET NC
        LD HL,silent_levels
        JP level_write
silence_extension_end:
        IF $ > FREEINST
        ERROR "Silence helper overlaps SFX allocator scratch"
        ENDIF
        BLOCK $1EC3-$
level_extension_start:
level_from_part:
        LD A,(NPARTS)
        OR A
        RET Z
        PUSH IX
        LD IX,(CURPART)
        CALL level_restore
        POP IX
        RET
wait_op:
        CALL fetch
        LD (WAIT),A
        RET
level_extension_end:
        IF $ > $1EDB
        ERROR "Level helper overlaps current SFX pointer"
        ENDIF
        BLOCK $1EF0-$
silent_levels:
        DB 127,127,127,127
        BLOCK $1EF7-$
pan_restore_start:
pan_from_part:
        LD HL,(CURPART)
        LD A,L
        ADD A,14
        LD L,A
        LD E,(HL)
        LD A,E
        OR A
        RET Z
        JP pan_write
pan_restore_end:
        IF $ > $1F05
        ERROR "Panning restore overlaps music patch shadows"
        ENDIF
        BLOCK $1F78-$
        DB $A5,$A5,$A5,$A5,$A5,$A5,$A5,$A5 ; main stack guard
        BLOCK $2000-$
