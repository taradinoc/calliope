dac_service:
        RET ; armed as DI ($F3) after alternate registers and timer exist
        EXX
        BIT 0,(HL)
        JR NZ,dac_tick
        EXX
        EI
        RET
dac_tick:
        LD (HL),$27
        LD A,$15
        LD (DE),A
        LD A,IYH
        CP C
        JP Z,dac_empty
        LD A,(BC)
        INC C
dac_output:
        LD (HL),$2A
        LD (DE),A
        EX AF,AF'
        SUB 1
        ADC A,0 ; saturate the frontier countdown at zero
        EX AF,AF'
        DEC IYL
        CALL Z,music_sync_dac
dac_no_tick:
        EXX
dac_return:
        EI
        RET

; Preserve live opcode/condition flags when polling between bounded helpers.
        BLOCK $30-$
dac_poll:
        PUSH AF
        RST $08
        POP AF
        RET

; Reuse vector padding for the direct PSG hook.
music_sync_psg_direct:
        OR A
        RET
